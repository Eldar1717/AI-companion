# AI Companion — optional environment overrides.
# Copy to ".env" (same folder) and edit. Every value is optional.

# --- server ---------------------------------------------------------------
AI_COMPANION_HOST=127.0.0.1
AI_COMPANION_PORT=8850
# Secret for the optional API token. Empty = browser-only access from this host.
AI_COMPANION_SECRET=

# --- storage (defaults: ./data and ./models) -------------------------------
AI_COMPANION_DATA=
AI_COMPANION_MODELS=
# Additional directories searched for Piper voices (comma separated)
AI_COMPANION_PIPER_DIRS=./models/piper,./models

# --- Ollama ---------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# --- speech ---------------------------------------------------------------
# tiny | base | small | medium | large-v3
AI_COMPANION_STT_MODEL=small
AI_COMPANION_STT_DEVICE=auto
AI_COMPANION_STT_COMPUTE=auto

# --- logging -------------------------------------------------------------
AI_COMPANION_LOG_LEVEL=INFO
